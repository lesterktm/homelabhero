#!/usr/bin/env bash
#
# hh - HomelabHero control CLI.
#
# Agent-safe (read-only, used by Claude): list, run, test, overview, inventory,
#   scan, doctor, unifi (read ops), firewalla (read ops).
# Operator (need sudo, run from an admin shell): add-host, add-unifi,
#   add-firewalla, rm-host, repin, update, login.
#
set -euo pipefail

HH_VERSION="1.4.3"
REG_DIR="/etc/homelabhero/hosts.d"
VAULT_DIR="/etc/homelabhero/vault"
VAULT_USER="hhvault"
AGENT_USER="hhagent"
BROKER="/usr/local/bin/hh-connect"
UNIFI_BROKER="/usr/local/bin/hh-unifi"
FIREWALLA_BROKER="/usr/local/bin/hh-firewalla"
UPDATER="/usr/local/bin/hh-update"
UPDATE_LOG="/var/log/homelabhero-update.log"
BROKER_LOG="/var/log/homelabhero-broker.log"
NAME_RE='^[A-Za-z0-9._-]+$'

die() { printf 'hh: %s\n' "$*" >&2; exit 1; }
ask() { local p="$1" d="${2:-}" a; if [ -n "$d" ]; then printf '%s [%s]: ' "$p" "$d" >/dev/tty; else printf '%s: ' "$p" >/dev/tty; fi; read -r a </dev/tty || true; echo "${a:-$d}"; }
asksecret() { local p="$1" a; printf '%s: ' "$p" >/dev/tty; read -rs a </dev/tty || true; printf '\n' >/dev/tty; echo "$a"; }
broker() { sudo -n -H -u "$VAULT_USER" "$BROKER" "$@"; }
conf_get() { awk -F= -v k="$2" '$1==k{sub(/^[^=]*=/,"");gsub(/^[ "]+|[ "]+$/,"");print;exit}' "$1"; }

usage() {
  cat <<'EOF'
HomelabHero

  hh list                      registered hosts (no secrets)
  hh run <alias> "<command>"   run a command on a host via the broker
  hh test <alias>              connectivity check
  hh overview                  read-only vitals sweep across all hosts
  hh inventory [alias]         what is RUNNING (VMs, LXCs, containers, apps)
                                 add --save to snapshot into inventory/
  hh scan [cidr]               discover live hosts on the network (read-only)
                                 add --add to pick and register them (operator)
  hh unifi <op> [alias] [args] read your UniFi router/console over its API.
                                 READ-ONLY: it can never change your network.
                                 ops: summary ping info sites devices device
                                      stats clients networks health get
                                 alias may be omitted with one console
  hh firewalla <op> [alias] [args]
                               read your Firewalla over the MSP API.
                                 READ-ONLY: it can never change your firewall.
                                 ops: summary ping info boxes devices device
                                      alarms flows bandwidth trends rules
                                      targetlists stats get
                                 alias may be omitted with one box
  hh doctor                    check the whole setup is healthy
  hh diff [alias]              inventory drift vs the last saved snapshot
  hh provision <alias> <host> [port] [platform] [user]
                               register a host with a generated key (key-only,
                               no password); prints the public key to install.
                               user defaults per platform (truenas ->
                               truenas_admin, else root); or pass user@host

  hh add-host                  register a host (operator, needs sudo)
  hh add-unifi                 register a UniFi router/console with a View Only
                               API key (operator, needs sudo)
  hh add-firewalla             register a Firewalla with an MSP API token
                               (operator, needs sudo)
  hh repin <alias>             re-pin a UniFi console's TLS key after you
                               changed its certificate (operator, needs sudo)
  hh rm-host <alias>           remove a host and its credential
  hh update                    update EVERYTHING now - HomelabHero (code, skills,
                               Node), then the OS packages (operator, needs sudo;
                               also runs weekly)
  hh login                     log Claude Code in as the agent user
  hh audit [lines]             review the broker audit log (operator, needs sudo)
  hh version                   print the HomelabHero version
EOF
}

# Remote command snippets (Linux shells; kept free of dollar signs and nested
# single quotes so they survive the trip through the broker to the remote shell).
# Root hosts (the default) run everything bare. Privileged tools (zpool, qm, pct,
# docker, virsh) take a per-host prefix from _priv: empty for root, "sudo -n " for
# a non-root admin that has passwordless sudo. midclt talks to the middleware and
# never needs sudo, so it is not prefixed.
VITALS_NIX="uptime -p 2>/dev/null || uptime; free -h | grep -i '^Mem'; df -h / | tail -1"
_inv_proxmox() { local p="$1"; echo "echo '# VMs'; ${p}qm list; echo; echo '# LXCs'; ${p}pct list; echo; echo '# Storage'; ${p}pvesm status"; }
# Compact tables for the TrueNAS middleware queries, so they read like the
# Proxmox qm/pct output instead of a wall of JSON.
#
# Both formatters take the raw midclt response on stdin and stay quiet when it
# is empty, which is the normal case for a namespace this version does not have
# (midclt writes that error to stderr, which the caller discards). If a response
# arrives that is NOT a JSON array, they say so rather than printing nothing:
# a silently empty section is indistinguishable from "nothing is running", and
# that is exactly the kind of blind spot this reporting exists to remove.
#
# Guests handle two API shapes: virt.instance.query (Incus, 25.04/25.10) has
# status as a string and a type of CONTAINER or VM; vm.query (libvirt, 24.10 and
# 26) has status as {state: ...} and no type.
_TN_UNEXPECTED='[print("(unexpected response: "+raw[:60]+")") for _ in [1] if raw and raw[:1]!="["]'
_TN_GUEST_FMT='import json,sys;raw=sys.stdin.read().strip();d=json.loads(raw) if raw[:1]=="[" else [];[print("%-22s %-10s %s" % (i.get("name","?"), i.get("type","VM"), i["status"]["state"] if isinstance(i.get("status"),dict) else i.get("status","?"))) for i in d];'"${_TN_UNEXPECTED}"
_TN_APP_FMT='import json,sys;raw=sys.stdin.read().strip();d=json.loads(raw) if raw[:1]=="[" else [];[print("%-22s %-10s %s" % (i.get("name","?"), i.get("state","?"), i.get("version",""))) for i in d];'"${_TN_UNEXPECTED}"
_inv_truenas() { local p="$1"; echo "echo '# Pools'; ${p}zpool list; echo; echo '# Docker'; ${p}docker ps 2>/dev/null; echo; echo '# Apps'; midclt call app.query 2>/dev/null | python3 -c '${_TN_APP_FMT}' | head -40; echo; echo '# VMs / LXCs'; { midclt call virt.instance.query 2>/dev/null | python3 -c '${_TN_GUEST_FMT}'; midclt call vm.query 2>/dev/null | python3 -c '${_TN_GUEST_FMT}'; } | head -40"; }
_inv_linux()   { local p="$1"; echo "echo '# Containers'; command -v docker >/dev/null 2>&1 && ${p}docker ps || echo '(no docker)'; echo; echo -n '# Running services: '; systemctl list-units --type=service --state=running --no-legend --no-pager 2>/dev/null | wc -l; echo; echo '# Libvirt'; command -v virsh >/dev/null 2>&1 && ${p}virsh list --all || echo '(no libvirt)'"; }

# ---- API hosts (UniFi, Firewalla) -------------------------------------------
#
# A router is registered like any other host but is reached over an HTTPS API
# instead of SSH, so everything that would shell into a host has to route around
# it. These helpers are how the rest of the CLI asks "is this one of those?"
# without duplicating the answer in a dozen places.
#
# The discriminator is PLATFORM, not AUTH. It used to be `AUTH=apikey`, which
# worked only while UniFi was the single API-reached platform: the moment a
# second one existed, every API host looked like a UniFi console and would have
# been handed to the UniFi broker by hh test, hh overview, hh inventory, and
# hh doctor alike. PLATFORM is what actually distinguishes them, and it has been
# written into every registry entry since the beginning, so this reads correctly
# on boxes registered by older versions too.

_platform_is() { [ -f "${REG_DIR}/$1.conf" ] && [ "$(conf_get "${REG_DIR}/$1.conf" PLATFORM)" = "$2" ]; }
_is_unifi()     { _platform_is "$1" unifi; }
_is_firewalla() { _platform_is "$1" firewalla; }

# "Reached over an API, so hh run and every shell-based sweep must skip it."
# Anything that would open an SSH session asks this, not the per-platform test.
_is_api_host() { _is_unifi "$1" || _is_firewalla "$1"; }

unifi_broker()     { sudo -n -H -u "$VAULT_USER" "$UNIFI_BROKER" "$@"; }
firewalla_broker() { sudo -n -H -u "$VAULT_USER" "$FIREWALLA_BROKER" "$@"; }

_unifi_aliases() { shopt -s nullglob; for f in "$REG_DIR"/*.conf; do
  local a; a="$(basename "$f" .conf)"; _is_unifi "$a" && printf '%s\n' "$a"; done; }

_firewalla_aliases() { shopt -s nullglob; for f in "$REG_DIR"/*.conf; do
  local a; a="$(basename "$f" .conf)"; _is_firewalla "$a" && printf '%s\n' "$a"; done; }

# Resolve which console a command means. Nearly every homelab has exactly one
# router, so naming it every time is friction with no benefit; require the alias
# only when there is a real choice to make.
_unifi_default() {
  local list; list="$(_unifi_aliases)"
  case "$(printf '%s' "$list" | grep -c .)" in
    0) die "no UniFi console registered yet. Register one from an admin shell: hh add-unifi" ;;
    1) printf '%s' "$list" ;;
    *) die "more than one UniFi console registered; name which one: $(printf '%s' "$list" | tr '\n' ' ')" ;;
  esac
}

cmd_unifi() {
  local op="${1:-}"; shift || true
  [ -n "$op" ] || die "usage: hh unifi <op> [alias] [args]  (ops: summary ping info sites devices device stats clients networks health get)"
  # The alias is optional and sits after the op. Consume it only if the next
  # argument actually names a registered console, so `hh unifi devices` and
  # `hh unifi devices gw` both do the obvious thing.
  local alias=""
  if [ -n "${1:-}" ] && _is_unifi "${1}"; then alias="$1"; shift; else alias="$(_unifi_default)"; fi
  exec sudo -n -H -u "$VAULT_USER" "$UNIFI_BROKER" "$op" "$alias" "$@"
}

# Same shape as the UniFi resolver, and separate on purpose: a homelab can have
# both a UniFi console and a Firewalla, and "the one router" is ambiguous the
# moment it does.
_firewalla_default() {
  local list; list="$(_firewalla_aliases)"
  case "$(printf '%s' "$list" | grep -c .)" in
    0) die "no Firewalla registered yet. Register one from an admin shell: hh add-firewalla" ;;
    1) printf '%s' "$list" ;;
    *) die "more than one Firewalla registered; name which one: $(printf '%s' "$list" | tr '\n' ' ')" ;;
  esac
}

cmd_firewalla() {
  local op="${1:-}"; shift || true
  [ -n "$op" ] || die "usage: hh firewalla <op> [alias] [args]  (ops: summary ping info boxes devices device alarms flows bandwidth trends rules targetlists stats get)"
  local alias=""
  if [ -n "${1:-}" ] && _is_firewalla "${1}"; then alias="$1"; shift; else alias="$(_firewalla_default)"; fi
  exec sudo -n -H -u "$VAULT_USER" "$FIREWALLA_BROKER" "$op" "$alias" "$@"
}

# Capture the console's TLS public key so later calls can verify they are still
# talking to the same box (trust on first use, like SSH's accept-new). Prints a
# curl --pinnedpubkey value, or nothing if it cannot be read.
_unifi_pin() {
  local host="$1" port="$2" pin
  pin="$(echo | openssl s_client -connect "${host}:${port}" -servername "$host" 2>/dev/null \
    | openssl x509 -pubkey -noout 2>/dev/null \
    | openssl pkey -pubin -outform der 2>/dev/null \
    | openssl dgst -sha256 -binary 2>/dev/null \
    | openssl base64 2>/dev/null)" || true
  pin="${pin//[[:space:]]/}"
  [ -n "$pin" ] && printf 'sha256//%s' "$pin"
}

# Privilege prefix for a host. Root => empty (runs bare). A non-root connect user
# => "sudo -n " but ONLY if that user has passwordless sudo, probed once per run
# and cached; otherwise empty, so we run bare and never trip the password prompt.
# midclt is never prefixed (it needs no sudo).
declare -A _PRIV_CACHE
_priv() {
  local a="$1"
  [ "$(conf_get "${REG_DIR}/$a.conf" USER)" = "root" ] && return 0
  if [ -z "${_PRIV_CACHE[$a]:-}" ]; then
    if broker "$a" 'sudo -n true' >/dev/null 2>&1; then _PRIV_CACHE[$a]='sudo -n '; else _PRIV_CACHE[$a]='none'; fi
  fi
  [ "${_PRIV_CACHE[$a]}" = 'none' ] || printf '%s' "${_PRIV_CACHE[$a]}"
  return 0
}

# ---- read-only, agent-safe --------------------------------------------------

cmd_list() {
  shopt -s nullglob
  local files=("$REG_DIR"/*.conf)
  [ "${#files[@]}" -gt 0 ] || { echo "No hosts registered yet. Run: hh add-host"; return 0; }
  printf '%-14s %-9s %-22s %-6s %-10s %s\n' ALIAS PLATFORM HOST PORT USER AUTH
  for f in "${files[@]}"; do
    local a; a="$(basename "$f" .conf)"
    printf '%-14s %-9s %-22s %-6s %-10s %s\n' \
      "$a" "$(conf_get "$f" PLATFORM)" "$(conf_get "$f" HOST)" \
      "$(conf_get "$f" PORT)" "$(conf_get "$f" USER)" "$(conf_get "$f" AUTH)"
  done
}

cmd_run() {
  [ "$#" -ge 2 ] || die "usage: hh run <alias> \"<command>\""
  local alias="$1"; shift
  [[ "$alias" =~ $NAME_RE ]] || die "invalid alias"
  exec sudo -n -H -u "$VAULT_USER" "$BROKER" "$alias" "$@"
}

cmd_test() {
  [ "$#" -eq 1 ] || die "usage: hh test <alias>"
  if _is_api_host "$1"; then
    local out ok=0
    if _is_unifi "$1"; then out="$(unifi_broker ping "$1" 2>&1)" && ok=1
    else out="$(firewalla_broker ping "$1" 2>&1)" && ok=1; fi
    if [ "$ok" -eq 1 ]; then echo "OK: $1 reachable ($out)"
    else echo "FAIL: $1 not reachable"; printf '%s\n' "$out" | sed 's/^/  /'; return 1; fi
    return 0
  fi
  if broker "$1" 'echo homelabhero-ok' 2>/dev/null | grep -q homelabhero-ok; then
    echo "OK: $1 reachable"
  else
    echo "FAIL: $1 not reachable (check registration, key authorization, mesh)"; return 1
  fi
}

_platform_of() { conf_get "${REG_DIR}/$1.conf" PLATFORM; }

cmd_overview() {
  shopt -s nullglob
  local files=("$REG_DIR"/*.conf)
  [ "${#files[@]}" -gt 0 ] || { echo "No hosts registered. Run: hh add-host"; return 0; }
  printf 'HomelabHero overview  %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
  for f in "${files[@]}"; do
    local a plat; a="$(basename "$f" .conf)"; plat="$(conf_get "$f" PLATFORM)"
    printf -- '---------------------------------------------\n## %s (%s)\n' "$a" "$plat"
    # A UniFi console has no shell to sweep; its vitals are WAN/LAN/WiFi health,
    # which is what the summary op reports. Capture first, then decide: piping
    # straight to sed would print the broker's error text and the UNREACHABLE
    # line, which reads like two different failures.
    if _is_api_host "$a"; then
      local uout ok=0
      if _is_unifi "$a"; then uout="$(unifi_broker summary "$a" 2>/dev/null)" && ok=1
      else uout="$(firewalla_broker summary "$a" 2>/dev/null)" && ok=1; fi
      if [ "$ok" -eq 1 ]; then printf '%s\n' "$uout" | sed 's/^/  /'
      else echo "  UNREACHABLE"; fi
      continue
    fi
    if ! broker "$a" 'true' 2>/dev/null; then echo "  UNREACHABLE"; continue; fi
    broker "$a" "$VITALS_NIX" 2>/dev/null | sed 's/^/  /' || true
    [ "$plat" = "truenas" ] && { echo -n "  zpool: "; broker "$a" "$(_priv "$a")zpool status -x" 2>/dev/null; }
  done
  echo '---------------------------------------------'
}

_inventory_one() {
  local a plat; a="$1"; plat="$(_platform_of "$a")"
  printf -- '=============================================\n# %s (%s)\n' "$a" "$plat"
  # "What is running" on the router means the gear it has adopted (APs,
  # switches, the gateway itself) plus how many clients are on the network.
  if _is_api_host "$a"; then
    local uout
    if _is_unifi "$a"; then
      uout="$(unifi_broker summary "$a" 2>/dev/null)" || { echo "UNREACHABLE"; return; }
      printf '%s\n' "$uout"; echo
      uout="$(unifi_broker devices "$a" 2>/dev/null)" && printf '%s\n' "$uout"
    else
      uout="$(firewalla_broker summary "$a" 2>/dev/null)" || { echo "UNREACHABLE"; return; }
      printf '%s\n' "$uout"; echo
      uout="$(firewalla_broker devices "$a" 2>/dev/null)" && printf '%s\n' "$uout"
    fi
    return
  fi
  if ! broker "$a" 'true' 2>/dev/null; then echo "UNREACHABLE"; return; fi
  local p; p="$(_priv "$a")"
  case "$plat" in
    proxmox) broker "$a" "$(_inv_proxmox "$p")" 2>/dev/null || true ;;
    truenas) broker "$a" "$(_inv_truenas "$p")" 2>/dev/null || true ;;
    *)       broker "$a" "$(_inv_linux "$p")"   2>/dev/null || true ;;
  esac
}

cmd_inventory() {
  local save=0 one=""
  for arg in "$@"; do case "$arg" in --save) save=1 ;; *) one="$arg" ;; esac; done
  shopt -s nullglob
  local aliases=()
  if [ -n "$one" ]; then aliases=("$one"); else for f in "$REG_DIR"/*.conf; do aliases+=("$(basename "$f" .conf)"); done; fi
  [ "${#aliases[@]}" -gt 0 ] || { echo "No hosts registered. Run: hh add-host"; return 0; }

  local out; out="$(printf 'HomelabHero inventory  %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')")"$'\n'
  for a in "${aliases[@]}"; do out+="$(_inventory_one "$a")"$'\n\n'; done
  printf '%s' "$out"

  if [ "$save" -eq 1 ]; then
    local dir="${HOME}/homelab-ops/inventory"
    if [ -d "$dir" ] && [ -w "$dir" ]; then
      printf '%s' "$out" > "${dir}/latest.md"
      echo "Saved snapshot to ${dir}/latest.md"
    else
      echo "(could not save: ${dir} not writable)" >&2
    fi
  fi
}

cmd_diff() {
  # Show what changed in the live inventory since the last saved snapshot. Pair
  # with `hh inventory --save` (which the box does over time), so this answers
  # "what appeared/vanished/changed since then?".
  local one="${1:-}"
  local base="${HOME}/homelab-ops/inventory/latest.md"
  [ -f "$base" ] || die "no saved snapshot at ${base} (run: hh inventory --save first)"
  local cur
  if [ -n "$one" ]; then cur="$(cmd_inventory "$one")"; else cur="$(cmd_inventory)"; fi
  # Ignore the volatile timestamp header line when comparing.
  if diff -u --label "snapshot (${base##*/})" --label "current (live)" \
       <(grep -v '^HomelabHero inventory' "$base") \
       <(printf '%s\n' "$cur" | grep -v '^HomelabHero inventory'); then
    echo "No drift since the last saved snapshot."
  fi
}

_registered_ips() { shopt -s nullglob; for f in "$REG_DIR"/*.conf; do conf_get "$f" HOST; done; }

# The address this box actually routes through. More reliable than guessing,
# and it is what makes "found your router" a statement rather than a hunch.
#
# Never fails: not knowing the default route is a normal state (an isolated LXC
# may have none) and only costs us one of two gateway hints, so it must not be
# able to abort a scan. The explicit `|| true` matters because pipefail would
# otherwise surface a missing `ip` as a fatal pipeline failure.
_default_gw() {
  ip route show default 2>/dev/null \
    | awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}' || true
}

# Is this IP the router? Either it is literally our default route, or it sits at
# the .1 of its subnet, which is where a home gateway lives often enough to be
# worth probing even when this box routes somewhere else (a scan of a subnet we
# are not on, a double-NAT lab, a VLAN with its own gateway).
_looks_like_gateway() {
  local ip="$1" gw="$2"
  [ -n "$gw" ] && [ "$ip" = "$gw" ] && return 0
  case "$ip" in *.1) return 0 ;; esac
  return 1
}

# Fingerprint a UniFi console without credentials. Echoes "<how> <version>" on a
# match. Ordered most to least certain: the Network application answers an
# unauthenticated status probe with its version, which is proof; the TLS
# certificate is only a strong hint, so it is the last resort rather than the
# first check.
_unifi_probe() {
  local ip="$1" body ver
  local url
  for url in "https://${ip}/proxy/network/status" "https://${ip}/status" "https://${ip}:8443/status"; do
    body="$(curl -sk -m 3 "$url" 2>/dev/null || true)"
    case "$body" in
      *server_version*)
        ver="$(printf '%s' "$body" | jq -r '.meta.server_version // empty' 2>/dev/null || true)"
        case "$url" in
          *:8443/status) printf 'controller %s' "${ver:-?}" ;;
          *)             printf 'console %s' "${ver:-?}" ;;
        esac
        return 0 ;;
    esac
  done
  body="$(echo | openssl s_client -connect "${ip}:443" -servername "$ip" 2>/dev/null \
    | openssl x509 -noout -subject -issuer 2>/dev/null || true)"
  case "$body" in
    *UniFi*|*Ubiquiti*|*unifi*|*ubnt*) printf 'certificate ?'; return 0 ;;
  esac
  return 1
}

cmd_scan() {
  local add=0 cidr=""
  for arg in "$@"; do case "$arg" in --add) add=1 ;; *) cidr="$arg" ;; esac; done
  [ -n "$cidr" ] || cidr="$(ip -o -f inet addr show scope global 2>/dev/null | awk '{print $4; exit}')"
  [ -n "$cidr" ] || die "could not detect a subnet; pass one, e.g. hh scan 10.0.0.0/24"
  echo "Scanning ${cidr} for management endpoints..." >&2

  # 8443 is the legacy self-hosted UniFi Network application; a UniFi OS console
  # (UDM, UCG, Cloud Key) answers on 443 like everything else.
  local ports="22,80,443,445,8006,8443"
  declare -a IPS PORTLIST
  if command -v nmap >/dev/null 2>&1; then
    while read -r ip openports; do
      IPS+=("$ip"); PORTLIST+=("$openports")
    done < <(nmap -Pn -T4 --open -p "$ports" -oG - "$cidr" 2>/dev/null \
      | awk -F'\t' '/Ports:/{ip=$1; sub(/Host: /,"",ip); sub(/ .*/,"",ip);
          p=$2; gsub(/Ports: /,"",p); gsub(/\/open[^,]*/,"",p); gsub(/,/,"",p); gsub(/ +/,",",p); sub(/^,/,"",p); print ip" "p}')
  else
    echo "(nmap not installed; slower basic scan. For better results: sudo apt install nmap)" >&2
    local base="${cidr%/*}"; base="${base%.*}"
    for n in $(seq 1 254); do
      local ip="${base}.${n}" open=""
      for p in 22 8006 443 445 80 8443; do
        timeout 1 bash -c "exec 3<>/dev/tcp/${ip}/${p}" 2>/dev/null && open="${open}${p} "
      done
      [ -n "$open" ] && { IPS+=("$ip"); PORTLIST+=("${open% }"); }
    done
  fi

  local regips gw; regips="$(_registered_ips | tr '\n' ' ')"; gw="$(_default_gw)"
  # Remember, per row, which entries are a confirmed UniFi console, so the
  # picker below can offer the API-key path instead of asking for SSH details
  # that a router does not have.
  declare -a UNIFI
  printf '\n%-4s %-16s %-20s %-16s %-9s %s\n' '#' 'IP' 'OPEN PORTS' 'GUESS' 'ROLE' 'REGISTERED?'
  local i=0 found_unifi=""
  for idx in "${!IPS[@]}"; do
    i=$((i+1))
    local ip="${IPS[$idx]}" op="${PORTLIST[$idx]}" guess reg="new" role="" uni=""
    case " ${op//,/ } " in
      *" 8006 "*) guess="proxmox" ;;
      *" 443 "*)  guess="truenas?/linux" ;;
      *" 22 "*)   guess="linux" ;;
      *)          guess="?" ;;
    esac
    # Probe for UniFi only where it could plausibly be one, so a full subnet
    # sweep does not pay for a handful of HTTPS round trips per host.
    local maybe_unifi=1
    _looks_like_gateway "$ip" "$gw" && { role="gateway"; maybe_unifi=0; }
    case " ${op//,/ } " in *" 8443 "*) maybe_unifi=0 ;; esac
    if [ "$maybe_unifi" -eq 0 ] && uni="$(_unifi_probe "$ip")"; then
      guess="unifi"; UNIFI[$idx]="$uni"
      [ -n "$found_unifi" ] || found_unifi="$i"
    fi
    case " $regips " in *" $ip "*) reg="registered" ;; esac
    printf '%-4s %-16s %-20s %-16s %-9s %s\n' "$i" "$ip" "${op// /,}" "$guess" "${role:--}" "$reg"
  done
  [ "$i" -gt 0 ] || { echo "No endpoints found."; return 0; }

  # Call the router out by name. It is the one device on this list a person may
  # not think of as "a server to add", and it is the one that explains the most
  # about why everything else is or is not working.
  if [ -n "$found_unifi" ]; then
    local uidx=$((found_unifi-1)) ukind uver udesc
    ukind="${UNIFI[$uidx]%% *}"; uver="${UNIFI[$uidx]#* }"
    case "$ukind" in
      console)     udesc="UniFi OS console running Network ${uver}" ;;
      controller)  udesc="self-hosted UniFi Network application ${uver} on port 8443" ;;
      *)           udesc="UniFi device (identified by its TLS certificate)" ;;
    esac
    cat <<EOF

Found your router: a ${udesc} at ${IPS[$uidx]}  (number ${found_unifi} above).
Adding it lets Claude see WAN and internet health, every adopted access point
and switch, connected clients, and pending firmware, so "the internet is down"
and "wifi is slow" become answerable instead of guesswork.

It connects with a UniFi API key, not SSH, and HomelabHero only ever READS from
it. It cannot change your network, by design.
EOF
  fi

  if [ "$add" -eq 1 ]; then
    # Registering hosts writes the registry and generates keys: an operator
    # action. Refuse cleanly for the low-privilege agent rather than failing
    # partway through the loop when the first sudo call is rejected.
    [ "$(id -u)" -eq 0 ] || sudo -v 2>/dev/null || \
      die "hh scan --add registers hosts and needs sudo; run it from an admin shell, not the Claude UI"
    echo
    local pick; pick="$(ask 'Numbers to register (comma-separated, blank to skip)')"
    IFS=',' read -ra nums <<<"$pick"
    for n in "${nums[@]}"; do
      n="${n// /}"; [[ "$n" =~ ^[0-9]+$ ]] || continue
      local idx=$((n-1)); [ -n "${IPS[$idx]:-}" ] || continue
      local ip="${IPS[$idx]}" op="${PORTLIST[$idx]}" plat=linux
      # A confirmed UniFi console is not an SSH host at all, so it skips the
      # platform question entirely rather than offering choices that do not
      # apply to it.
      if [ -n "${UNIFI[$idx]:-}" ]; then
        echo; echo "Registering ${ip} as your UniFi router ..."
        cmd_add_host --host "$ip" --port 443 --platform unifi
        continue
      fi
      # Guess from open ports, then let the operator confirm or correct it
      # (443 alone is often TrueNAS, but just as often a plain Linux web host).
      case " ${op//,/ } " in
        *" 8006 "*) plat=proxmox ;;
        *" 443 "*)  plat=truenas ;;
      esac
      plat="$(ask "Platform for ${ip} (linux/truenas/proxmox/unifi)" "$plat")"
      echo; echo "Registering ${ip} as ${plat} ..."
      if [ "$plat" = "unifi" ]; then cmd_add_host --host "$ip" --port 443 --platform unifi
      else cmd_add_host --host "$ip" --port 22 --platform "$plat"; fi
    done
  else
    echo; echo "To register: hh scan ${cidr} --add   (or: hh add-host)"
  fi
}

cmd_doctor() {
  local fail=0 warn=0
  ok()   { printf '  [ok]   %s\n' "$*"; }
  bad()  { printf '  [FAIL] %s\n' "$*"; fail=$((fail+1)); }
  note() { printf '  [warn] %s\n' "$*"; warn=$((warn+1)); }

  echo "HomelabHero doctor"
  echo "Setup"
  id "$AGENT_USER" >/dev/null 2>&1 && ok "agent user ${AGENT_USER} exists" || bad "missing user ${AGENT_USER}"
  id "$VAULT_USER" >/dev/null 2>&1 && ok "vault user ${VAULT_USER} exists" || bad "missing user ${VAULT_USER}"
  [ -x "$BROKER" ] && ok "broker installed" || bad "broker missing at ${BROKER}"
  [ -x "$UNIFI_BROKER" ] && ok "unifi broker installed (read-only)" || note "unifi broker missing at ${UNIFI_BROKER} (run: hh update)"
  [ -x "$FIREWALLA_BROKER" ] && ok "firewalla broker installed (read-only)" || note "firewalla broker missing at ${FIREWALLA_BROKER} (run: hh update)"
  if [ -d "$VAULT_DIR" ]; then
    local perm; perm="$(stat -c '%a %U' "$VAULT_DIR" 2>/dev/null || true)"
    [ "$perm" = "700 ${VAULT_USER}" ] && ok "vault perms (${perm})" || note "vault perms are '${perm}', expected '700 ${VAULT_USER}'"
  else bad "vault dir missing"; fi
  if [ -f "$BROKER_LOG" ]; then
    local bperm; bperm="$(stat -c '%a %U' "$BROKER_LOG" 2>/dev/null || true)"
    [ "$bperm" = "600 ${VAULT_USER}" ] && ok "broker audit log protected (${bperm})" || note "broker audit log perms are '${bperm}', expected '600 ${VAULT_USER}'"
  else note "broker audit log not present yet (${BROKER_LOG})"; fi

  echo "Runtime"
  if systemctl is-active --quiet homelab-cc; then ok "service homelab-cc active"; else bad "service homelab-cc not active"; fi
  local ahome cv
  ahome="$(getent passwd "$AGENT_USER" | cut -d: -f6)"
  cv="$(sudo -n -u "$AGENT_USER" -H bash -c "export NVM_DIR=\"${ahome}/.nvm\"; [ -s \"\$NVM_DIR/nvm.sh\" ] && . \"\$NVM_DIR/nvm.sh\" >/dev/null 2>&1; command -v claude >/dev/null && claude --version" 2>/dev/null | tail -1 || true)"
  [ -n "$cv" ] && ok "claude: ${cv}" || note "could not read claude version here (fine if not run with sudo)"

  echo "Hosts"
  shopt -s nullglob
  local files=("$REG_DIR"/*.conf)
  [ "${#files[@]}" -eq 0 ] && note "no hosts registered yet (hh add-host)"
  for f in "${files[@]}"; do
    local a u; a="$(basename "$f" .conf)"; u="$(conf_get "$f" USER)"
    if _is_unifi "$a"; then
      if unifi_broker ping "$a" >/dev/null 2>&1; then
        ok "reach ${a} (unifi API, read-only)"
        [ -n "$(conf_get "$f" PIN)" ] || note "${a} has no TLS pin; re-pin it with: hh repin ${a}"
      else
        bad "cannot reach ${a} over the UniFi API (key rejected, console down, or cert changed)"
        printf '           detail: %s\n' "$(unifi_broker ping "$a" 2>&1 | head -1)"
      fi
      continue
    fi
    if _is_firewalla "$a"; then
      if firewalla_broker ping "$a" >/dev/null 2>&1; then
        ok "reach ${a} (firewalla MSP API, read-only)"
      else
        bad "cannot reach ${a} over the Firewalla MSP API (token rejected, no active plan, or box offline)"
        printf '           detail: %s\n' "$(firewalla_broker ping "$a" 2>&1 | head -1)"
      fi
      continue
    fi
    if ! broker "$a" 'echo ok' 2>/dev/null | grep -q ok; then bad "cannot reach ${a}"; continue; fi
    if [ "$u" = "root" ] || broker "$a" 'sudo -n true' >/dev/null 2>&1; then ok "reach ${a} (${u})"
    else
      note "reach ${a} (${u}) - no passwordless sudo: raw root tools (docker, zpool, smartctl) will not run (midclt still works)."
      printf '           fix: TrueNAS UI -> Credentials -> Users -> %s -> Edit -> "Allow all sudo commands with no password"; or re-register %s as root.\n' "$u" "$a"
    fi
  done

  echo "Auto-update"
  if [ -f "$UPDATE_LOG" ]; then ok "last update log: $(tail -1 "$UPDATE_LOG" 2>/dev/null | cut -c1-70)"
  else note "no update has run yet (${UPDATE_LOG} not present)"; fi

  echo
  if [ "$fail" -gt 0 ]; then echo "RESULT: ${fail} problem(s), ${warn} warning(s)."; return 1
  else echo "RESULT: healthy (${warn} warning(s))."; fi
}

# ---- operator ---------------------------------------------------------------

cmd_add_host() {
  local alias="" host="" port="" plat="" ruser="" auth="" cred=""
  while [ "$#" -gt 0 ]; do case "$1" in
    --alias) alias="$2"; shift 2 ;;
    --host) host="$2"; shift 2 ;;
    --port) port="$2"; shift 2 ;;
    --platform) plat="$2"; shift 2 ;;
    *) shift ;;
  esac; done

  [ "$(id -u)" -eq 0 ] || sudo -v || die "add-host needs sudo (run from an admin shell, not the Claude UI)"
  # Platform is settled before the alias so a UniFi console can suggest a
  # sensible name and then skip every SSH question, which does not apply to it.
  [ -n "$plat" ] || plat="$(ask 'Platform (linux/truenas/proxmox/unifi/firewalla)' linux)"
  case "$plat" in linux|truenas|proxmox|unifi|firewalla) : ;; *) die "unknown platform: ${plat} (linux, truenas, proxmox, unifi, firewalla)" ;; esac
  if [ -z "$alias" ]; then
    case "$plat" in
      unifi)     alias="$(ask 'Alias (short name for your router)' router)" ;;
      firewalla) alias="$(ask 'Alias (short name for your firewall)' firewalla)" ;;
      *)         alias="$(ask 'Alias (short name, e.g. pve1)')" ;;
    esac
  fi
  [[ "$alias" =~ $NAME_RE ]] || die "invalid alias"
  [ -f "${REG_DIR}/${alias}.conf" ] && die "alias already registered"
  # A Firewalla is addressed by its MSP portal domain, not by a LAN IP, so it
  # asks its own question rather than the generic one.
  if [ "$plat" = "firewalla" ]; then _add_firewalla_host "$alias" "$host" "${port:-443}"; return; fi
  [ -n "$host" ] || host="$(ask 'IP or hostname')"
  if [ "$plat" = "unifi" ]; then _add_unifi_host "$alias" "$host" "${port:-443}"; return; fi
  [ -n "$port" ] || port="$(ask 'SSH port' 22)"
  ruser="$(ask 'Username' root)"
  auth="$(ask 'Auth method (key recommended / password)' key)"

  case "$auth" in
    key)
      cred="${alias}.key"
      echo "Generating a dedicated key in the vault..." >/dev/tty
      sudo -u "$VAULT_USER" ssh-keygen -t ed25519 -N '' -q -f "${VAULT_DIR}/${cred}" -C "homelabhero-${alias}"
      echo >/dev/tty; echo "Public key to authorize on ${host}:" >/dev/tty
      sudo cat "${VAULT_DIR}/${cred}.pub" >/dev/tty; echo >/dev/tty
      if [ "$(ask 'Install it now via ssh-copy-id? (needs the remote password once) (y/N)' N)" = "y" ]; then
        sudo -u "$VAULT_USER" ssh-copy-id -i "${VAULT_DIR}/${cred}.pub" -p "$port" "${ruser}@${host}" </dev/tty || \
          echo "ssh-copy-id did not complete; authorize the key manually." >/dev/tty
      fi
      ;;
    password)
      echo "WARNING: password auth is weaker and harder to isolate. Prefer keys." >/dev/tty
      cred="${alias}.pw"
      local pw; pw="$(asksecret "Password for ${ruser}@${host}")"
      printf '%s' "$pw" | sudo -u "$VAULT_USER" tee "${VAULT_DIR}/${cred}" >/dev/null
      sudo -u "$VAULT_USER" chmod 600 "${VAULT_DIR}/${cred}"; unset pw
      ;;
    *) die "unknown auth method" ;;
  esac

  sudo tee "${REG_DIR}/${alias}.conf" >/dev/null <<EOF
# HomelabHero host registry entry (non-secret)
PLATFORM=${plat}
HOST=${host}
PORT=${port}
USER=${ruser}
AUTH=${auth}
CRED=${cred}
EOF
  sudo chmod 644 "${REG_DIR}/${alias}.conf"
  echo "Registered '${alias}'. Testing..." >/dev/tty
  cmd_test "$alias" || true
}

# Register a UniFi console. Operator-only and shell-only, for the same reason
# password auth is: an API key is a secret being typed, and a secret typed into
# an LLM session has already been seen by the LLM. There is deliberately no
# UI/agent path to this (nothing in hh-provision registers one).
_add_unifi_host() {
  local alias="$1" host="$2" port="$3" cred="${1}.apikey" key pin
  cat >/dev/tty <<EOF

Registering ${host} as a UniFi router.

HomelabHero reads your UniFi console over its local API, which needs an API key.
Create one in the UniFi Network app:

  1. Settings -> Control Plane -> Integrations -> Create API Key
     (older versions put it under Settings -> Admins, or Control Plane ->
     Admins; the wording moved between Network 8, 9, and 10.)
  2. Give it a name like "homelabhero" and copy the key. UniFi shows it once.

  IMPORTANT: create the key under an admin whose role is VIEW ONLY.

  The key inherits that admin's permissions, so a View Only admin produces a key
  that physically cannot change your network - the console itself refuses the
  write. HomelabHero never issues anything but reads either, so this is a second
  lock on the same door. If you mint the key under a full admin instead, this
  tool still will not write, but the key in the vault would be able to.

  Requires a UniFi OS console (UDM, UCG, Cloud Key Gen2+, UniFi OS Server) on
  Network 9.0 or newer. API keys do not exist on the old self-hosted app.

EOF
  key="$(asksecret "UniFi API key for ${host}")"
  [ -n "$key" ] || die "no key entered"
  printf '%s' "$key" | sudo -u "$VAULT_USER" tee "${VAULT_DIR}/${cred}" >/dev/null
  sudo -u "$VAULT_USER" chmod 600 "${VAULT_DIR}/${cred}"
  unset key

  # Pin the console's TLS public key now, while we are talking to it for the
  # first time and can reasonably assume the LAN is honest. Every later call
  # verifies against this, which is what stops the key being handed to an
  # impostor on the network later.
  echo "Pinning the console's TLS key..." >/dev/tty
  pin="$(_unifi_pin "$host" "$port" || true)"
  [ -n "$pin" ] || echo "  (could not read the certificate; continuing unpinned)" >/dev/tty

  sudo tee "${REG_DIR}/${alias}.conf" >/dev/null <<EOF
# HomelabHero host registry entry (non-secret)
PLATFORM=unifi
HOST=${host}
PORT=${port}
USER=api-key
AUTH=apikey
CRED=${cred}
PIN=${pin}
EOF
  sudo chmod 644 "${REG_DIR}/${alias}.conf"

  echo >/dev/tty; echo "Registered '${alias}'. Testing..." >/dev/tty
  if cmd_test "$alias"; then
    # Resolve and cache the site id so the first real command is not slower
    # than every one after it.
    unifi_broker sites "$alias" >/dev/null 2>&1 || true
    echo >/dev/tty
    unifi_broker summary "$alias" 2>&1 | sed 's/^/  /' >/dev/tty || true
  else
    cat >/dev/tty <<EOF

The key did not work. Nothing is broken; the registration is saved but unusable.
Check that you copied the whole key and that the console is on Network 9.0+,
then replace it:

    hh rm-host ${alias}
    hh add-unifi
EOF
  fi
}

# Pin which box on the MSP account an alias refers to.
#
# The MSP API is a fleet API: one token can see every Firewalla on the account,
# and every read has to name one of them. The broker caches that choice in the
# registry entry, but it can only make the choice unattended when there is
# exactly one box. With two it has to ask - and the broker runs as the vault
# user with no terminal to ask from, which is why this lives here, at
# registration, where a person is actually present.
#
# Without this the two halves deadlocked: the broker refused to guess and told
# you to "re-register naming the one you mean", and registration had no way to
# name one.
_firewalla_pick_box() {
  local alias="$1" f="${REG_DIR}/${alias}.conf" j n gid name
  j="$(firewalla_broker get "$alias" /v2/boxes 2>/dev/null)" || j=""
  # A failed fetch is deliberately not diagnosed here. The reachability test
  # that follows says exactly what went wrong - bad token, no active plan,
  # unreachable - and two messages for one cause reads like two faults.
  printf '%s' "$j" | jq -e 'type == "array"' >/dev/null 2>&1 || return 0
  n="$(printf '%s' "$j" | jq -r 'length')"

  case "$n" in
    0)
      echo "  (the MSP listed no boxes; nothing to pin)" >/dev/tty
      return 0 ;;
    1)
      gid="$(printf '%s' "$j" | jq -r '.[0].gid // empty')"
      name="$(printf '%s' "$j" | jq -r '.[0].name // "Firewalla"')"
      ;;
    *)
      cat >/dev/tty <<EOF

This MSP account manages ${n} Firewalla boxes. One alias reads one box, so pick
which one '${alias}' should mean. To read the others too, register them the same
way under their own aliases.

EOF
      printf '%s' "$j" | jq -r 'to_entries[] |
        "\(.key + 1)\t\(.value.name // "?")\t\(.value.model // "?")\t\(.value.mode // "-")\t\(if .value.online then "online" else "OFFLINE" end)\t\(.value.gid // "-")"' \
        | awk -F'\t' 'BEGIN{printf "  %-3s %-22s %-10s %-9s %-9s %s\n","#","NAME","MODEL","MODE","STATE","GID"}
                        {printf "  %-3s %-22s %-10s %-9s %-9s %s\n",$1,$2,$3,$4,$5,$6}' >/dev/tty
      echo >/dev/tty
      local pick idx
      while :; do
        pick="$(ask "Which box is '${alias}'? (1-${n})" 1)"
        pick="${pick// /}"
        if [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le "$n" ]; then break; fi
        echo "  Enter a number between 1 and ${n}." >/dev/tty
      done
      idx=$((pick-1))
      gid="$(printf '%s' "$j" | jq -r --argjson i "$idx" '.[$i].gid // empty')"
      name="$(printf '%s' "$j" | jq -r --argjson i "$idx" '.[$i].name // "Firewalla"')"
      ;;
  esac

  if [ -z "$gid" ]; then
    echo "  (could not read a box id; it will be resolved on first use)" >/dev/tty
    return 0
  fi
  # Replace rather than append, so re-registering over an entry that already
  # carries a stale pin does the right thing.
  sudo sed -i '/^BOX=/d;/^BOX_NAME=/d' "$f"
  printf 'BOX=%s\nBOX_NAME=%s\n' "$gid" "$name" | sudo tee -a "$f" >/dev/null
  if [ "$n" -gt 1 ]; then echo "  Pinned '${alias}' to ${name}." >/dev/tty; fi
  return 0
}

# Register a Firewalla. Operator-only and shell-only, for the same reason the
# UniFi one is: an API token is a secret being typed, and a secret typed into an
# LLM session has already been seen by the LLM. There is deliberately no
# UI/agent path to this (nothing in hh-provision registers one).
_add_firewalla_host() {
  local alias="$1" host="$2" port="$3" cred="${1}.apitoken" token
  cat >/dev/tty <<'EOF'

Registering a Firewalla.

HomelabHero reads your Firewalla through the Firewalla MSP API - the cloud
portal, not the box itself. Firewalla publishes no supported local API, so this
is the only documented way in.

  1. Open your MSP portal (https://<yourname>.firewalla.net). If you have never
     used it, the free "MSP Lite" tier is at my.firewalla.com; API access needs
     an account with an active plan.
  2. Account Settings -> Create New Token. Name it "homelabhero" and copy it.
     Firewalla shows the token once.

  A NOTE ON PERMISSIONS, because it differs from UniFi: Firewalla has no
  "View Only" token tier. The token you paste below carries every permission
  your MSP account has, including creating and deleting firewall rules.
  HomelabHero never issues anything but GET - the broker has no code path that
  can write, and every write-shaped command is refused by name - so nothing here
  can use that power. But unlike UniFi, that is the ONLY thing stopping it, so
  keep this token as carefully as you would any admin credential, and delete it
  in the portal if you ever stop using HomelabHero.

EOF
  [ -n "$host" ] || host="$(ask 'MSP domain (e.g. yourname.firewalla.net)')"
  # Accept a pasted URL and reduce it to a bare host, because the portal address
  # bar is where most people will copy this from.
  host="${host#http://}"; host="${host#https://}"; host="${host%%/*}"
  [ -n "$host" ] || die "no MSP domain entered"

  token="$(asksecret "Firewalla MSP personal access token for ${host}")"
  [ -n "$token" ] || die "no token entered"
  printf '%s' "$token" | sudo -u "$VAULT_USER" tee "${VAULT_DIR}/${cred}" >/dev/null
  sudo -u "$VAULT_USER" chmod 600 "${VAULT_DIR}/${cred}"
  unset token

  # No TLS pin here, unlike UniFi. The MSP is a public host with an ordinary
  # publicly-trusted certificate that Firewalla rotates on its own schedule;
  # pinning something we do not control would break on every renewal, and a
  # pin that people are trained to re-accept is worse than no pin at all.
  # Normal CA validation is the right check for this endpoint and is always on.
  sudo tee "${REG_DIR}/${alias}.conf" >/dev/null <<EOF
# HomelabHero host registry entry (non-secret)
PLATFORM=firewalla
API=msp
HOST=${host}
PORT=${port}
USER=api-token
AUTH=apitoken
CRED=${cred}
EOF
  sudo chmod 644 "${REG_DIR}/${alias}.conf"

  echo >/dev/tty; echo "Registered '${alias}'. Testing..." >/dev/tty
  # Settle which box this alias means BEFORE testing reachability, not after.
  # On an account with more than one box every read has to name one, and that
  # includes the ping the test does - so pinning second would make a perfectly
  # good token look broken.
  _firewalla_pick_box "$alias"
  if cmd_test "$alias"; then
    echo >/dev/tty
    firewalla_broker summary "$alias" 2>&1 | sed 's/^/  /' >/dev/tty || true
  else
    cat >/dev/tty <<EOF

The token did not work. Nothing is broken; the registration is saved but
unusable. Check that you copied the whole token, that the MSP domain is right,
and that the account has an active plan (API access requires one), then replace
it:

    hh rm-host ${alias}
    hh add-firewalla
EOF
  fi
}

cmd_add_firewalla() {
  [ "$(id -u)" -eq 0 ] || sudo -v || die "add-firewalla needs sudo (run from an admin shell, not the Claude UI)"
  cmd_add_host --platform firewalla "$@"
}

cmd_add_unifi() {
  [ "$(id -u)" -eq 0 ] || sudo -v || die "add-unifi needs sudo (run from an admin shell, not the Claude UI)"
  cmd_add_host --platform unifi "$@"
}

# Re-pin after the console's certificate legitimately changes (a firmware
# update, or installing your own cert). Separate and operator-only on purpose:
# accepting a new key is exactly what an attacker would want, so it should be a
# thing a person chooses to do, never something that happens quietly.
cmd_repin() {
  [ "$#" -eq 1 ] || die "usage: hh repin <alias>"
  local alias="$1" f="${REG_DIR}/$1.conf"
  [ -f "$f" ] || die "no such host"
  # A Firewalla lands here often enough to deserve a real answer: it is the other
  # API-reached platform, so "re-pin it" is a reasonable thing to try, and the
  # generic refusal explains neither why it does not apply nor what does.
  if ! _is_unifi "$alias"; then
    if _is_firewalla "$alias"; then
      die "'${alias}' is a Firewalla, which has no TLS pin to refresh: it is reached at
    an MSP domain with a publicly trusted certificate, so ordinary CA validation
    applies and there is nothing pinned to go stale. If you meant to change WHICH
    BOX this alias reads, re-register it and pick again:
        hh rm-host ${alias} && hh add-firewalla"
    fi
    die "'${alias}' is not a UniFi console. Only a UniFi console is TLS-pinned,
    because only it presents a self-signed certificate."
  fi
  [ "$(id -u)" -eq 0 ] || sudo -v || die "repin needs sudo (run from an admin shell, not the Claude UI)"
  local host port pin
  host="$(conf_get "$f" HOST)"; port="$(conf_get "$f" PORT)"
  pin="$(_unifi_pin "$host" "${port:-443}" || true)"
  [ -n "$pin" ] || die "could not read a certificate from ${host}:${port}"
  sudo sed -i "/^PIN=/d" "$f"
  printf 'PIN=%s\n' "$pin" | sudo tee -a "$f" >/dev/null
  echo "Re-pinned ${alias} (${host})."
  cmd_test "$alias"
}

cmd_rm_host() {
  [ "$#" -eq 1 ] || die "usage: hh rm-host <alias>"
  local f="${REG_DIR}/$1.conf"; [ -f "$f" ] || die "no such host"
  local cred; cred="$(conf_get "$f" CRED)"
  sudo rm -f "$f"
  [ -n "$cred" ] && sudo -u "$VAULT_USER" rm -f "${VAULT_DIR}/${cred}" "${VAULT_DIR}/${cred}.pub" 2>/dev/null || true
  echo "Removed $1"
}

cmd_update() {
  [ -x "$UPDATER" ] || die "updater not installed at ${UPDATER}"
  echo "Updating HomelabHero and the OS now (you will be asked for sudo)..."
  sudo "$UPDATER"
}

cmd_audit() {
  # Operator-only. The broker audit log is owned by the vault user and is
  # unreadable by the agent by design (a hijacked agent must not be able to read
  # or erase its own tracks), so reviewing it needs real sudo.
  local n="${1:-40}"
  [[ "$n" =~ ^[0-9]+$ ]] || die "usage: hh audit [lines]"
  [ -f "$BROKER_LOG" ] || die "no broker audit log yet at ${BROKER_LOG}"
  echo "Last ${n} brokered actions (time  alias  user@host:port  command):"
  sudo tail -n "$n" "$BROKER_LOG"
}

cmd_provision() {
  [ "$#" -ge 2 ] || die "usage: hh provision <alias> <host> [port] [platform] [user]"
  exec sudo -n -u "$VAULT_USER" /usr/local/bin/hh-provision "$@"
}

cmd_login() {
  local ahome; ahome="$(getent passwd "$AGENT_USER" | cut -d: -f6)"
  echo "Starting Claude Code as ${AGENT_USER}. Run /login inside, then type /exit." >/dev/tty
  # Force HOME to the agent's home (do not rely on sudo -i) and load nvm so the
  # claude binary is on PATH. Otherwise claude reads root's ~/.claude and fails.
  # Launch from the ops brain so project settings resolve there (not the caller's
  # cwd) and the homelab-ops project is registered for the web UI, skills and all.
  sudo -u "$AGENT_USER" -H bash -c "export HOME='${ahome}'; export NVM_DIR=\"\$HOME/.nvm\"; [ -s \"\$NVM_DIR/nvm.sh\" ] && . \"\$NVM_DIR/nvm.sh\"; cd \"\$HOME/homelab-ops\" 2>/dev/null || cd \"\$HOME\"; exec claude"
}

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)      cmd_list "$@" ;;
    run)       cmd_run "$@" ;;
    test)      cmd_test "$@" ;;
    overview)  cmd_overview "$@" ;;
    inventory) cmd_inventory "$@" ;;
    diff)      cmd_diff "$@" ;;
    scan)      cmd_scan "$@" ;;
    unifi)     cmd_unifi "$@" ;;
    firewalla) cmd_firewalla "$@" ;;
    doctor)    cmd_doctor "$@" ;;
    provision) cmd_provision "$@" ;;
    add-host)  cmd_add_host "$@" ;;
    add-unifi) cmd_add_unifi "$@" ;;
    add-firewalla) cmd_add_firewalla "$@" ;;
    repin)     cmd_repin "$@" ;;
    rm-host)   cmd_rm_host "$@" ;;
    update)    cmd_update "$@" ;;
    login)     cmd_login "$@" ;;
    audit)     cmd_audit "$@" ;;
    version|--version|-V) echo "hh (HomelabHero) ${HH_VERSION}"; echo "What changed: https://github.com/serversathome/homelabhero/blob/main/CHANGELOG.md" ;;
    ''|-h|--help|help) usage ;;
    *) die "unknown command: ${sub} (try: hh help)" ;;
  esac
}
main "$@"
